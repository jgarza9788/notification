#!/usr/bin/env bash
#
# Omarchy 4.5-compatible backend for jgarza.notification.
# Reads aggregate history.json and live.json files.
#
set -uo pipefail
umask 077

state_home=${XDG_STATE_HOME:-$HOME/.local/state}
src_dir=${NS_SRC_DIR:-$state_home/omarchy/notifications}
history_file=$src_dir/history.json
live_file=$src_dir/live.json

store=${NS_STORE:-$state_home/jgarza-notification}
archive=$store/archive.jsonl
images=$store/images
seen_file=$store/seen
removed_file=$store/removed
lock_file=$store/lock

keep_days=${NS_KEEP_DAYS:-30}
max_items=${NS_MAX_ITEMS:-500}

[[ $keep_days =~ ^[0-9]+$ ]] || keep_days=30
[[ $max_items =~ ^[0-9]+$ ]] || max_items=500

json_str() { printf '%s' "$1" | jq -Rs .; }

die() {
    printf '{"ok":false,"error":%s}\n' "$(json_str "$1")"
    exit 1
}

command -v jq >/dev/null 2>&1 || die "jq is not installed"

ensure_store() {
    mkdir -p "$store" "$images" || die "cannot create $store"
    [[ -f $archive ]] || : > "$archive"
    [[ -f $removed_file ]] || : > "$removed_file"
    chmod 700 "$store" "$images" 2>/dev/null || true
}

with_lock() {
    ( exec 9>"$lock_file"; flock 9; "$@" )
}

now_ms() {
    printf '%s' "$(($(date +%s%N) / 1000000))"
}

have_key() {
    grep -qF "\"key\":\"$1\"" "$archive" 2>/dev/null
}

was_removed() {
    grep -qxF "$1" "$removed_file" 2>/dev/null
}

is_path() {
    [[ $1 == /* || $1 == file:///* ]]
}

copy_image() {
    local src=${1#file://}
    local dest="$images/$2-$3"

    [[ -f $src ]] || return 0
    (( $(stat -c%s -- "$src" 2>/dev/null || echo 0) <= 5242880 )) || return 0

    case "$(file -bL --mime-type -- "$src" 2>/dev/null)" in
        image/*) ;;
        *) return 0 ;;
    esac

    cp -f -- "$src" "$dest" 2>/dev/null && printf '%s' "$dest"
}

# Ingest one notification object from an aggregate JSON array.
ingest_record() {
    local record=$1
    local key icon image file_src entry

    key=$(jq -r '.key // empty | tostring' <<< "$record")
    [[ -n $key && $key =~ ^[A-Za-z0-9-]+$ ]] || return 0

    have_key "$key" && return 0
    was_removed "$key" && return 0

    icon=$(jq -r '.appIcon // "" | tostring' <<< "$record")
    image=$(jq -r '.image // "" | tostring' <<< "$record")

    if is_path "$icon"; then
        icon=$(copy_image "$icon" "$key" icon)
    fi

    if is_path "$image"; then
        image=$(copy_image "$image" "$key" image)
    fi

    file_src=$(jq -r '
        .execArgv // ""
        | (if type == "string" then (fromjson? // []) else . end)
        | if type == "array" then .[] else empty end
        | strings
        | select(test("^/.*\\.(png|jpe?g|webp|gif)$"; "i"))
    ' <<< "$record" 2>/dev/null | head -n 1)

    entry=$(jq -c \
        --arg appIcon "$icon" \
        --arg image "$image" \
        --arg file "$file_src" '
        {
            key: (.key | tostring),
            id: (.id // 0),
            originalId: (.originalId // .id // 0),
            app: (.app // "" | tostring),
            appIcon: $appIcon,
            summary: (.summary // "" | tostring),
            body: (.body // "" | tostring),
            image: $image,
            file: $file,
            glyph: (.glyph // "" | tostring),
            urgency: (.urgency // 1),
            execArgv: (.execArgv // ""),
            execActions: (.execActions // ""),
            timestamp: (
                (.ts // .timestamp // 0 | tonumber? // 0) as $t
                | if $t > 0 then
                    (if $t < 100000000000 then $t * 1000 else $t end)
                  else 0 end
            )
        }
    ' <<< "$record") || return 0

    [[ -n $entry ]] || return 0

    # Fall back to the current time if the source has no usable timestamp.
    entry=$(jq -c --argjson now "$(now_ms)" '
        if .timestamp <= 0 then .timestamp = $now else . end
    ' <<< "$entry")

    printf '%s\n' "$entry" >> "$archive"
    printf '%s\n' "$entry"
}

# Read both aggregate files. quiet.json is DND configuration, not a
# notification collection.
sync_all() {
    local source record

    for source in "$history_file" "$live_file"; do
        [[ -s $source ]] || continue

        while IFS= read -r record; do
            [[ -n $record ]] && ingest_record "$record"
        done < <(jq -c '.[]? | objects' "$source" 2>/dev/null)
    done
}

prune() {
    local cutoff kept f key

    [[ -s $archive ]] || return 0

    cutoff=$(( $(now_ms) - keep_days * 86400000 ))

    kept=$(jq -ncR --argjson cutoff "$cutoff" '
        [inputs | fromjson? | objects
        | select((.timestamp | type) == "number"
        and .timestamp >= $cutoff)]
        | sort_by(.timestamp) | .[]
    ' "$archive" 2>/dev/null | tail -n "$max_items")

    printf '%s\n' "$kept" | grep -v '^$' > "$archive.tmp" || : > "$archive.tmp"

    for f in "$images"/*; do
        [[ -e $f ]] || continue
        key=$(basename -- "$f")
        key=${key%-*}
        grep -qF "\"key\":\"$key\"" "$archive.tmp" || rm -f -- "$f"
    done

    mv -f "$archive.tmp" "$archive"
}

cmd_sync() {
    ensure_store
    with_lock sync_all >/dev/null
    with_lock prune
}

cmd_watch() {
    ensure_store
    cmd_sync

    command -v inotifywait >/dev/null 2>&1 || die "inotifywait is not installed"

    exec 3< <(
        inotifywait -m -q -e close_write -e moved_to \
            --format '%w%f' "$src_dir" "$store" 2>/dev/null
    )

    local watcher=$!
    trap 'kill "$watcher" 2>/dev/null' EXIT INT TERM

    local changed file

    while IFS= read -r file <&3; do
        case "$file" in
            "$archive"|"$seen_file")
                printf '{"changed":true}\n'
                continue
                ;;
            "$store"/*)
                continue
                ;;
            "$history_file"|"$live_file")
                changed=$(with_lock sync_all)
                with_lock prune

                if [[ -n $changed ]]; then
                    printf '%s\n' "$changed"
                else
                    printf '{"changed":true}\n'
                fi
                ;;
        esac
    done
}

cmd_list() {
    ensure_store
    local limit=${1:-500}
    [[ $limit =~ ^[0-9]+$ ]] || limit=500

    jq -ncR --argjson n "$limit" '
        [inputs | fromjson? | objects
        | select((.timestamp | type) == "number")]
        | sort_by(-.timestamp) | .[:$n]
    ' "$archive" 2>/dev/null || printf '[]\n'
}

remove_key() {
    grep -vF "\"key\":\"$1\"" "$archive" > "$archive.tmp" || : > "$archive.tmp"
    mv -f "$archive.tmp" "$archive"

    rm -f -- "$images/$1-icon" "$images/$1-image"

    was_removed "$1" || printf '%s\n' "$1" >> "$removed_file"
}

cmd_remove() {
    local key

    ensure_store
    (( $# > 0 )) || die "remove needs a key"

    for key; do
        [[ $key =~ ^[A-Za-z0-9-]+$ ]] || die "invalid notification key"
    done

    for key; do
        with_lock remove_key "$key"
    done

    printf '{"ok":true,"removed":%s}\n' "$(json_str "$*")"
}

clear_all() {
    jq -r '.key // empty' "$archive" 2>/dev/null >> "$removed_file"
    : > "$archive"
    rm -f -- "$images"/*
}

cmd_clear() {
    ensure_store
    with_lock clear_all

    if [[ -z ${NS_SRC_DIR:-} ]] && command -v omarchy-shell >/dev/null 2>&1; then
        omarchy-shell notifications clear >/dev/null 2>&1 || true
    fi

    printf '{"ok":true,"cleared":true}\n'
}

cmd_live() {
    if [[ ! -s $live_file ]]; then
        printf '[]\n'
        return
    fi

    jq -c '
        [.[]? | objects
        | select(.key != null)
        | {key: (.key | tostring), ts: (.ts // 0)}]
        | sort_by(-.ts)
        | map(.key)
    ' "$live_file" 2>/dev/null || printf '[]\n'
}

cmd_seen() {
    ensure_store

    if [[ ${1:-} =~ ^[0-9]+$ ]]; then
        printf '%s\n' "$1" > "$seen_file"
    fi

    printf '{"ok":true,"seen":%s}\n' \
        "$(cat "$seen_file" 2>/dev/null || echo 0)"
}

case ${1:-} in
    watch)
        cmd_watch
        ;;
    sync)
        cmd_sync
        printf '{"ok":true}\n'
        ;;
    list)
        cmd_list "${2:-500}"
        ;;
    remove)
        shift
        cmd_remove "$@"
        ;;
    clear)
        cmd_clear
        ;;
    prune)
        ensure_store
        with_lock prune
        printf '{"ok":true}\n'
        ;;
    live)
        cmd_live
        ;;
    seen)
        cmd_seen "${2:-}"
        ;;
    *)
        die "usage: notification-store watch|sync|list [N]|remove KEY...|clear|prune|live|seen [MS]"
        ;;
esac
